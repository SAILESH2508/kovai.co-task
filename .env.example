# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Secret Key
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-strong-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database
# For local development, SQLite is used automatically.
# For production, set this to your PostgreSQL connection string.
DATABASE_URL=sqlite:///./tasks.db

# CORS - Frontend origin(s) allowed to call the API
# Local development:
FRONTEND_ORIGIN=http://localhost:5173
# Production example:
# FRONTEND_ORIGIN=https://your-app.vercel.app

# ============================================================
# FRONTEND ENVIRONMENT VARIABLES (.env in frontend/ folder)
# ============================================================
# VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
# VITE_API_URL=http://localhost:8000
